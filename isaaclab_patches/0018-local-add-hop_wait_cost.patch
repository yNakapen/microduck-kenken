+    term.set_command(torch.tensor([[0.0, 0.0, 1.0]]))
+    for _ in range(10):
+        term.compute(0.02)
+    assert term.hop_time.item() == pytest.approx(0.2)
+    term.set_command(torch.tensor([[0.0, 0.0, 0.0]]))
+    term.compute(0.02)
+    assert term.hop_time.item() == 0.0
+
