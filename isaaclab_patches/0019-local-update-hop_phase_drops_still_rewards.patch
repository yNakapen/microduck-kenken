diff --git a/source/isaaclab_tasks/isaaclab_tasks/contrib/microduck/mdp/flamingo_hop.py b/source/isaaclab_tasks/isaaclab_tasks/contrib/microduck/mdp/flamingo_hop.py
index 1e6d54189..6008c5071 100644
--- a/source/isaaclab_tasks/isaaclab_tasks/contrib/microduck/mdp/flamingo_hop.py
+++ b/source/isaaclab_tasks/isaaclab_tasks/contrib/microduck/mdp/flamingo_hop.py
@@ -20,7 +20,13 @@ import torch
 from isaaclab.managers import CommandTerm, CommandTermCfg, SceneEntityCfg
 from isaaclab.utils.configclass import configclass
 
-from .flamingo import foot_in_contact, joint_vel_gaussian
+from .flamingo import (
+    foot_in_contact,
+    foot_site_height_gaussian,
+    joint_vel_gaussian,
+    pose_target_match,
+    projected_gravity_match,
+)
 from .observations import zero_non_finite
 
 if TYPE_CHECKING:
@@ -189,3 +195,40 @@ def still_joint_vel_gaussian(
 ) -> torch.Tensor:
     """:func:`joint_vel_gaussian`, faded out while hopping."""
     return (1.0 - _beta(env, command_name)) * joint_vel_gaussian(env, std, asset_cfg, gate_sensor_cfg)
+
+
+def still_foot_site_height_gaussian(
+    env: ManagerBasedRLEnv,
+    command_name: str,
+    target: float,
+    std: float,
+    asset_cfg: SceneEntityCfg,
+    gate_sensor_cfg: SceneEntityCfg | None = None,
+) -> torch.Tensor:
+    """:func:`foot_site_height_gaussian`, faded out while hopping."""
+    reward = foot_site_height_gaussian(env, target, std, asset_cfg, gate_sensor_cfg)
+    return (1.0 - _beta(env, command_name)) * reward
+
+
+def still_pose_target_match(
+    env: ManagerBasedRLEnv, command_name: str, target: Sequence[float], std: float, asset_cfg: SceneEntityCfg
+) -> torch.Tensor:
+    """:func:`pose_target_match`, faded out while hopping."""
+    return (1.0 - _beta(env, command_name)) * pose_target_match(env, target, std, asset_cfg)
+
+
+def still_projected_gravity_match(
+    env: ManagerBasedRLEnv,
+    command_name: str,
+    target: tuple[float, float, float],
+    std: float,
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """:func:`projected_gravity_match`, faded out while hopping."""
+    return (1.0 - _beta(env, command_name)) * projected_gravity_match(env, target, std, asset_cfg)
+
+
+def still_action_rate_l2(env: ManagerBasedRLEnv, command_name: str) -> torch.Tensor:
+    """Squared change of the policy actions, faded out while hopping."""
+    rate = env.action_manager.action - env.action_manager.prev_action
+    return (1.0 - _beta(env, command_name)) * (rate**2).sum(dim=1)
diff --git a/source/isaaclab_tasks/test/test_microduck_flamingo_hop.py b/source/isaaclab_tasks/test/test_microduck_flamingo_hop.py
index 39ddd2aca..488dfa1be 100644
--- a/source/isaaclab_tasks/test/test_microduck_flamingo_hop.py
+++ b/source/isaaclab_tasks/test/test_microduck_flamingo_hop.py
@@ -193,6 +193,25 @@ def test_still_scaled_terms_fade_out_while_hopping():
     torch.testing.assert_close(reward, torch.tensor([1.0, 0.5, 0.0]))
 
 
+def test_still_action_rate_fades_out_while_hopping():
+    env = _fake_env(beta=[0.0, 0.5, 1.0])
+    env.action_manager = SimpleNamespace(action=torch.ones(3, 2), prev_action=torch.zeros(3, 2))
+    torch.testing.assert_close(mdp.still_action_rate_l2(env, "base_velocity"), torch.tensor([2.0, 1.0, 0.0]))
+
+
+def test_still_gravity_and_pose_matches_fade_out_while_hopping():
+    env = _fake_env(beta=[0.0, 1.0])
+    robot = env.scene["robot"]
+    robot.data.projected_gravity_b = SimpleNamespace(torch=torch.tensor([[0.0, 0.0, -1.0]] * 2))
+    robot.data.joint_pos = SimpleNamespace(torch=torch.zeros(2, 2))
+    gravity = mdp.still_projected_gravity_match(env, "base_velocity", target=(0.0, 0.0, -1.0), std=0.15)
+    torch.testing.assert_close(gravity, torch.tensor([1.0, 0.0]))
+    pose = mdp.still_pose_target_match(
+        env, "base_velocity", target=[0.0, 0.0], std=0.5, asset_cfg=SceneEntityCfg("robot", joint_ids=[0, 1])
+    )
+    torch.testing.assert_close(pose, torch.tensor([1.0, 0.0]))
+
+
 """
 Environment.
 """
@@ -255,6 +274,17 @@ def test_hop_rewards(hop_env):
     assert manager.get_term_cfg("hop_air_time").params["swing_sensor_cfg"].body_names == ["ankle_left"]
     # The swing foot must be up 0.1 s before the takeoff: the first policy pushed off with it 93 % of the time.
     assert manager.get_term_cfg("hop_air_time").params["swing_lead_time"] == 0.1
+    # Terms that pay for keeping still are off while hopping.
+    still_funcs = {
+        "stance_foot_grounded": mdp.still_foot_in_contact,
+        "stillness": mdp.still_joint_vel_gaussian,
+        "swing_foot_clear": mdp.still_foot_site_height_gaussian,
+        "pose_flamingo": mdp.still_pose_target_match,
+        "gravity_flamingo": mdp.still_projected_gravity_match,
+        "action_rate_l2": mdp.still_action_rate_l2,
+    }
+    for name, func in still_funcs.items():
+        assert manager.get_term_cfg(name).func is func, name
 
 
 @pytest.mark.integration
